{
  "anchorLines": [
    "function B738_fmc_disp_capt()"
  ],
  "beginMarker": "-- BEGIN CPDLC PATCH AOC FREE TEXT MODULE",
  "contentLines": [
    "-- Additive extension kept separate from the 1.1.0 module so installed packages",
    "-- can be upgraded structurally by both the standalone installer and the Toolkit.",
    "",
    "cpdlc_patch_aoc_page = 0 -- 0 none, 1 compose, 2 verify",
    "cpdlc_patch_aoc_target = \"\"",
    "cpdlc_patch_aoc_text = { \"\", \"\", \"\", \"\" }",
    "cpdlc_patch_aoc_status = \"\"",
    "",
    "function cpdlc_patch_aoc_entry_is_fo()",
    "\treturn fmc2_input_lag == 1 and fmc1_input_lag ~= 1",
    "end",
    "",
    "function cpdlc_patch_aoc_entry_get()",
    "\tif cpdlc_patch_aoc_entry_is_fo() then",
    "\t\treturn entry2",
    "\tend",
    "\treturn entry",
    "end",
    "",
    "function cpdlc_patch_aoc_entry_clear()",
    "\tif cpdlc_patch_aoc_entry_is_fo() then",
    "\t\tentry2 = \"\"",
    "\telse",
    "\t\tentry = \"\"",
    "\tend",
    "end",
    "",
    "function cpdlc_patch_aoc_target_valid(value)",
    "\treturn value ~= nil and string.len(value) >= 1 and string.len(value) <= 24",
    "\t\tand string.find(value, \"^[A-Z0-9%-]+$\") ~= nil",
    "end",
    "",
    "function cpdlc_patch_aoc_text_valid(value)",
    "\treturn value ~= nil and string.len(value) <= 24",
    "end",
    "",
    "function cpdlc_patch_aoc_message()",
    "\tlocal result = \"\"",
    "\tfor index = 1, 4 do",
    "\t\tlocal value = cpdlc_patch_trim(cpdlc_patch_aoc_text[index])",
    "\t\tif value ~= \"\" then",
    "\t\t\tif result ~= \"\" then result = result .. \" \" end",
    "\t\t\tresult = result .. value",
    "\t\tend",
    "\tend",
    "\treturn result",
    "end",
    "",
    "function cpdlc_patch_aoc_ready()",
    "\treturn cpdlc_patch_aoc_target_valid(cpdlc_patch_aoc_target)",
    "\t\tand cpdlc_patch_aoc_message() ~= \"\"",
    "end",
    "",
    "function cpdlc_patch_aoc_open()",
    "\t-- Keep the stock MISC page active so its datalink ownership/lifecycle remains",
    "\t-- in force while the extension replaces only the visible page and key map.",
    "\tpage_dl_misc = 1",
    "\tcpdlc_patch_aoc_page = 1",
    "\tcpdlc_patch_aoc_status = \"\"",
    "\tact_page = 1",
    "\tdisplay_update = 1",
    "end",
    "",
    "function cpdlc_patch_aoc_return_to_misc()",
    "\tcpdlc_patch_aoc_page = 0",
    "\tpage_dl_misc = 1",
    "\tact_page = 1",
    "\tdisplay_update = 1",
    "end",
    "",
    "function cpdlc_patch_aoc_reset()",
    "\tcpdlc_patch_aoc_page = 0",
    "\tcpdlc_patch_aoc_target = \"\"",
    "\tcpdlc_patch_aoc_text = { \"\", \"\", \"\", \"\" }",
    "\tcpdlc_patch_aoc_status = \"\"",
    "end",
    "",
    "function cpdlc_patch_aoc_draw_compose()",
    "\tmax_page_buf = 1",
    "\tline0_l = \"     AOC FREE TEXT      \"",
    "\tline1_x = \" TO                     \"",
    "\tline1_l = \"<\" .. cpdlc_patch_aoc_target",
    "\tline2_x = \" MESSAGE                \"",
    "\tline2_l = \"<\" .. cpdlc_patch_aoc_text[1]",
    "\tline3_l = \"<\" .. cpdlc_patch_aoc_text[2]",
    "\tline4_l = \"<\" .. cpdlc_patch_aoc_text[3]",
    "\tline5_l = \"<\" .. cpdlc_patch_aoc_text[4]",
    "\tif cpdlc_patch_aoc_ready() then",
    "\t\tline6_l = cpdlc_patch_lr(\"<RETURN\", \"VERIFY>\")",
    "\telse",
    "\t\tline6_l = \"<RETURN                 \"",
    "\tend",
    "end",
    "",
    "function cpdlc_patch_aoc_draw_verify()",
    "\tmax_page_buf = 1",
    "\tline0_l = \" AOC FREE TEXT VERIFY   \"",
    "\tline1_x = \" TO                     \"",
    "\tline1_l = \" \" .. cpdlc_patch_aoc_target",
    "\tline2_x = \" MESSAGE                \"",
    "\tline2_l = \" \" .. cpdlc_patch_aoc_text[1]",
    "\tline3_l = \" \" .. cpdlc_patch_aoc_text[2]",
    "\tline4_l = \" \" .. cpdlc_patch_aoc_text[3]",
    "\tline5_l = \" \" .. cpdlc_patch_aoc_text[4]",
    "\tline6_l = cpdlc_patch_lr(\"<RETURN\", \"SEND>\")",
    "end",
    "",
    "function cpdlc_patch_aoc_set_field(index)",
    "\tlocal value = cpdlc_patch_aoc_entry_get()",
    "\tif value == \">DELETE\" then",
    "\t\tvalue = \"\"",
    "\telseif value == \"\" then",
    "\t\tif index == 0 then",
    "\t\t\tvalue = cpdlc_patch_aoc_target",
    "\t\telse",
    "\t\t\tvalue = cpdlc_patch_aoc_text[index]",
    "\t\tend",
    "\t\tif cpdlc_patch_aoc_entry_is_fo() then entry2 = value else entry = value end",
    "\t\treturn",
    "\tend",
    "\tlocal valid = cpdlc_patch_aoc_text_valid(value)",
    "\tif index == 0 then valid = cpdlc_patch_aoc_target_valid(value) end",
    "\tif not valid then",
    "\t\tadd_fmc_msg(INVALID_INPUT, 0, 0)",
    "\t\treturn",
    "\tend",
    "\tif index == 0 then",
    "\t\tcpdlc_patch_aoc_target = value",
    "\telse",
    "\t\tcpdlc_patch_aoc_text[index] = value",
    "\tend",
    "\tcpdlc_patch_aoc_entry_clear()",
    "\tcpdlc_patch_aoc_status = \"\"",
    "end",
    "",
    "function cpdlc_patch_aoc_lsk(key)",
    "\tif cpdlc_patch_aoc_page == 1 then",
    "\t\tif key == \"6L\" then",
    "\t\t\tcpdlc_patch_aoc_return_to_misc()",
    "\t\telseif key == \"6R\" and cpdlc_patch_aoc_ready() then",
    "\t\t\tcpdlc_patch_aoc_page = 2",
    "\t\telseif key == \"1L\" then",
    "\t\t\tcpdlc_patch_aoc_set_field(0)",
    "\t\telseif key == \"2L\" then",
    "\t\t\tcpdlc_patch_aoc_set_field(1)",
    "\t\telseif key == \"3L\" then",
    "\t\t\tcpdlc_patch_aoc_set_field(2)",
    "\t\telseif key == \"4L\" then",
    "\t\t\tcpdlc_patch_aoc_set_field(3)",
    "\t\telseif key == \"5L\" then",
    "\t\t\tcpdlc_patch_aoc_set_field(4)",
    "\t\tend",
    "\t\treturn true",
    "\telseif cpdlc_patch_aoc_page == 2 then",
    "\t\tif key == \"6L\" then",
    "\t\t\tcpdlc_patch_aoc_page = 1",
    "\t\telseif key == \"6R\" then",
    "\t\t\tif not cpdlc_patch_aoc_ready() then",
    "\t\t\t\tcpdlc_patch_aoc_page = 1",
    "\t\t\t\tadd_fmc_msg(\"REVERIFY\", 0, 0)",
    "\t\t\telseif HBDR_ready == 0 or HBDR_comm_ready == 0 then",
    "\t\t\t\tadd_fmc_msg(\"NO COMM\", 0, 0)",
    "\t\t\telse",
    "\t\t\t\tsend_telex(cpdlc_patch_aoc_message(), cpdlc_patch_aoc_target)",
    "\t\t\t\tcpdlc_patch_aoc_target = \"\"",
    "\t\t\t\tcpdlc_patch_aoc_text = { \"\", \"\", \"\", \"\" }",
    "\t\t\t\tcpdlc_patch_aoc_status = \"SENT\"",
    "\t\t\t\tcpdlc_patch_aoc_return_to_misc()",
    "\t\t\tend",
    "\t\tend",
    "\t\treturn true",
    "\tend",
    "\treturn false",
    "end",
    "",
    "cpdlc_patch_aoc_overlay_orig = cpdlc_patch_overlay",
    "function cpdlc_patch_overlay()",
    "\tif cpdlc_patch_aoc_page ~= 0 then",
    "\t\tnull_fmc_disp()",
    "\t\tif cpdlc_patch_aoc_page == 1 then",
    "\t\t\tcpdlc_patch_aoc_draw_compose()",
    "\t\telse",
    "\t\t\tcpdlc_patch_aoc_draw_verify()",
    "\t\tend",
    "\t\treturn",
    "\tend",
    "\tcpdlc_patch_aoc_overlay_orig()",
    "\tif page_dl_misc == 1 then",
    "\t\tline4_l = cpdlc_patch_lr(\"<PASSWORD\", \"FREE TEXT>\")",
    "\t\tif cpdlc_patch_aoc_status ~= \"\" then",
    "\t\t\tline5_l = cpdlc_patch_lr(\"\", cpdlc_patch_aoc_status)",
    "\t\tend",
    "\tend",
    "end",
    "",
    "cpdlc_patch_aoc_lsk_orig = cpdlc_patch_lsk",
    "function cpdlc_patch_lsk(key)",
    "\tif cpdlc_patch_aoc_lsk(key) then",
    "\t\tdisplay_update = 1",
    "\t\treturn true",
    "\tend",
    "\tif page_dl_misc == 1 and key == \"4R\" then",
    "\t\tcpdlc_patch_aoc_open()",
    "\t\treturn true",
    "\tend",
    "\treturn cpdlc_patch_aoc_lsk_orig(key)",
    "end",
    "",
    "cpdlc_patch_aoc_clear_orig = cpdlc_patch_clear",
    "function cpdlc_patch_clear()",
    "\tcpdlc_patch_aoc_clear_orig()",
    "\tcpdlc_patch_aoc_reset()",
    "end"
  ],
  "endMarker": "-- END CPDLC PATCH AOC FREE TEXT MODULE",
  "format": "insert-marked-block-v1",
  "name": "CPDLC AOC free text module",
  "position": "before"
}
